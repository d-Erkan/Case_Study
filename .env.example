# All values are optional; the defaults match the SUT's docker-compose.yml.
API_BASE_URL=http://localhost:8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=bezkoder_db

# Signing secret hard-coded in the SUT (app/config/auth.config.js). Used only to
# craft *expired* tokens without waiting 60 s. See docs/DESIGN.md.
SUT_JWT_SECRET=bezkoder-secret-key

# Known-bug handling: "xfail" (default, suite stays green while documenting bugs)
# or "strict" (tests assert the documented contract and go red on every bug).
KNOWN_BUGS=xfail

# Set to 1 to skip the tests that crash the API process (BUG-002 / BUG-003).
SKIP_DESTRUCTIVE=0

# Set to 1 to run the real-time token-expiry scenario (waits ~65 s).
RUN_SLOW=0

# Path to a PEM CA bundle when behind a TLS-intercepting proxy (see README).
# EXTRA_CA_CERT=/path/to/corporate-ca.pem
